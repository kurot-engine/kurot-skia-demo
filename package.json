        "react-native-worklets": "0.10.1"
    },
    "devDependencies": {
        "@kurot/cli": "3.6.0",
        "@kurot/skia": "file:../Kurot-Skia",
        "@kurot/ui-document": "0.13.1",
        "@types/node": "^22.20.5",
        "@types/react": "~19.2.2",
        "eslint": "^9.39.5",
        "eslint-config-expo": "~57.0.2",
        "typescript": "~6.0.3"
    },
    "scripts": {
        "start": "pnpm generate:project && expo start",
