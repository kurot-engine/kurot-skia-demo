    "dependencies": {
        "@formatjs/intl-segmenter": "12.2.15",
        "@kurot/core": "2.5.3",
        "@kurot/ui": "3.5.0",
        "expo": "~57.0.27",
        "expo-build-properties": "~57.0.22",
        "expo-dev-client": "~57.0.19",
        "expo-status-bar": "~57.0.1",
        "react": "19.2.3",
        "react-native": "0.86.3",
        "react-native-reanimated": "4.5.1",
